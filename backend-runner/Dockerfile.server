# backend-runner/Dockerfile.server
FROM node:20-slim

ENV DEBIAN_FRONTEND=noninteractive

# System deps for node-pty + docker CLI
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    ca-certificates \
    curl \
    gnupg \
    lsb-release \
    && rm -rf /var/lib/apt/lists/*

# Install Docker CLI
RUN mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
    https://download.docker.com/linux/debian $(lsb_release -cs) stable" \
    > /etc/apt/sources.list.d/docker.list && \
    apt-get update && \
    apt-get install -y docker-ce-cli && \
    rm -rf /var/lib/apt/lists/*

# REQUIRED: runner temp dir
RUN mkdir -p /tmp/runner && chmod 777 /tmp/runner

WORKDIR /backend-runner

# Copy only backend-runner package files
COPY package.json package-lock.json ./

RUN npm install --production

# Copy backend-runner source
COPY server.js ./

EXPOSE 8080

CMD ["node", "server.js"]
